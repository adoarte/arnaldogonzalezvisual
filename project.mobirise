          },
          "_name": "image2",
          "_customHTML": "<section group=\"Images & Videos\">\n\n  <div class=\"carousel-wrapper\">\n  <figure class=\"mbr-figure\">\n    <div class=\"carousel-container\">\n    \n            <div class=\"slide\">\n        <img src=\"@PROJECT_PATH@/assets/images/holzhauer-hamburg-galerie-arnaldo-gonzalez-volcano-video-1280x720px-2014-1500eur-51-ap-2132x1389.jpg\" alt=\"Imagen 1\" data-caption=\"Exhibition view: Mixed media installation, Jupiter First Floor, Hamburg, Germany, 2023\" title>\n      </div>\n        \n          <div class=\"slide\">\n        <img src=\"@PROJECT_PATH@/assets/images/holzhauer-hamburg-galerie-arnaldo-gonzalez-volcano-video-1280x720px-2014-1500eur-51-ap-2132x1389.jpg\" alt=\"Imagen 3\" data-caption=\"Resguardo y Presencia (Performance documentation), 2018–2025. Ongoing research on the dramaturgy of concealment and the body as an archive in transition.\" title>\n      </div>\n\n           <div class=\"slide\">\n        <img src=\"@PROJECT_PATH@/assets/images/holzhauer-hamburg-galerie-arnaldo-gonzalez-volcano-video-1280x720px-2014-1500eur-51-ap-2132x1389.jpg\" alt data-caption=\"Troscurpos: From the Crown to the Wind (videostill), 2025. Digital video, black and white, sound. Special Mention: Villa de Leyva International Film Festival, Colombia, 2025\" title>\n         </div>\n         \n\n      \n    </div>\n  </figure>\n\n<!-- MODAL PERSONALIZADO -->\n<div id=\"custom-modal\">\n  <button class=\"modal-close\">×</button>\n  <button class=\"modal-arrow left\">❮</button>\n  <button class=\"modal-arrow right\">❯</button>\n\n  <div class=\"modal-wrapper\">\n    <div class=\"modal-slide\">\n      <img id=\"modal-img\" src=\"file:///C:/Users/adoar/AppData/Local/Mobirise.com/Mobirise/adoarte_0040gmail_002ecom/userblocks/mobirise4/image2_59\" alt>\n      <div id=\"modal-caption\" style=\"display:block;\"></div>\n    </div>\n  </div>\n</div>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function(){\n  const slides = document.querySelectorAll(\".slide img\");\n  const modal = document.getElementById(\"custom-modal\");\n  const modalImg = document.getElementById(\"modal-img\");\n  const modalCaption = document.getElementById(\"modal-caption\");\n  const modalClose = modal.querySelector(\".modal-close\");\n  const prevBtn = modal.querySelector(\".modal-arrow.left\");\n  const nextBtn = modal.querySelector(\".modal-arrow.right\");\n\n  let currentIndex = 0;\n\n  slides.forEach((img,index)=>{\n    img.addEventListener(\"click\", ()=>{\n      modal.classList.add(\"active\");\n      modalImg.src = img.src;\n      modalCaption.textContent = img.dataset.caption || \"\";\n      currentIndex = index;\n    });\n  });\n\n  modalClose.addEventListener(\"click\", ()=> modal.classList.remove(\"active\"));\n  modal.addEventListener(\"click\", e=> { if(e.target===modal) modal.classList.remove(\"active\"); });\n\n  prevBtn.addEventListener(\"click\", e=>{\n    e.stopPropagation();\n    currentIndex = (currentIndex - 1 + slides.length) % slides.length;\n    modalImg.src = slides[currentIndex].src;\n    modalCaption.textContent = slides[currentIndex].dataset.caption || \"\";\n  });\n\n  nextBtn.addEventListener(\"click\", e=>{\n    e.stopPropagation();\n    currentIndex = (currentIndex + 1) % slides.length;\n    modalImg.src = slides[currentIndex].src;\n    modalCaption.textContent = slides[currentIndex].dataset.caption || \"\";\n  });\n});\n</script>\n</div></section>",
