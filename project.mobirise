            },
            ".modal-arrow": {
              "position": "absolute",
              "top": "50%",
              "transform": "translateY(-50%)",
              "font-size": "40px",
              "background": "none",
              "border": "none",
              "cursor": "pointer"
            },
            ".modal-arrow.left": {
