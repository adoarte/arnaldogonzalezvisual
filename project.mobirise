    "works.html": {
      "settings": {
        "title": "Works | Arnaldo Drés González",
        "meta_descr": "Arnaldo Drés González is a Venezuelan visual artist based in Hamburg exploring the instability of perception, bodily memory, displacement, and the transformation of moving image into spatial and material form.",
        "header_custom": "",
        "footer_custom": "<!-- CONTENEDOR DEL VISOR (LIGHTBOX ORIGINAL CORREGIDO) -->\n<div id=\"lightbox\" style=\"display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.95); justify-content:center; align-items:center; z-index:999999; overflow:hidden; cursor:pointer;\">\n  <!-- Usamos la etiqueta exacta que Mobirise reconoce, con transformaciones puras en el CSS -->\n  <img src=\"\" alt=\"Expanded Image\" style=\"max-width:90%; max-height:90%; object-fit:contain; box-shadow: 0 10px 30px rgba(0,0,0,0.8); border: 1px solid rgba(255,255,255,0.1); transition: transform 0.1s ease-out; transform-origin: center center; cursor: zoom-in;\">\n</div>\n\n<!-- SCRIPT DE INTERACCIÓN INTEGRAL -->\n<script>\n  document.addEventListener('DOMContentLoaded', () => {\n    const lightbox = document.getElementById('lightbox');\n    const lightboxImg = lightbox ? lightbox.querySelector('img') : null;\n\n    if (!lightbox || !lightboxImg) return;\n\n    let currentScale = 1;\n    const minScale = 1;\n    const maxScale = 4; // Zoom máximo de 4x\n\n    function resetZoom() {\n      currentScale = 1;\n      lightboxImg.style.transform = 'scale(1)';\n      lightboxImg.style.transformOrigin = 'center center';\n      lightboxImg.style.cursor = 'zoom-in';\n    }\n\n    // 1. ABRIR EL LIGHTBOX (Copia exacta de tu primer script que sí funcionaba)\n    document.addEventListener('click', (e) => {\n      const targetImg = e.target.closest('.mbr-figure img, .image-block img, .item-img img, .card-img img');\n      \n      if (targetImg && !targetImg.closest('.menu-logo, .navbar, #lightbox')) {\n        resetZoom();\n        lightboxImg.src = targetImg.src; // Transferencia directa de la ruta\n        lightbox.style.display = 'flex'; // Muestra el visor\n      }\n    });\n\n    // 2. EFECTO ZOOM CON LA RUEDA DIRIGIDO AL PUNTERO DEL RATÓN\n    lightbox.addEventListener('wheel', function(e) {\n      e.preventDefault(); // Bloquea el scroll de la página de fondo\n\n      // Calcular la posición del mouse relativa a las dimensiones de la imagen expandida\n      const rect = lightboxImg.getBoundingClientRect();\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n\n      // Obtener los porcentajes de ubicación del puntero del mouse\n      const xPercent = (x / rect.width) * 100;\n      const yPercent = (y / rect.height) * 100;\n\n      // Cambiar el nivel del zoom según el giro de la rueda\n      if (e.deltaY < 0) {\n        currentScale = Math.min(maxScale, currentScale + 0.3);\n      } else {\n        currentScale = Math.max(minScale, currentScale - 0.3);\n      }\n\n      if (currentScale <= 1) {\n        resetZoom();\n      } else {\n        // Fijamos el centro de ampliación exactamente bajo el puntero actual\n        lightboxImg.style.transformOrigin = `${xPercent}% ${yPercent}%`;\n        lightboxImg.style.transform = `scale(${currentScale})`;\n        lightboxImg.style.cursor = 'zoom-out';\n      }\n    }, { passive: false });\n\n    // 3. EXPLORACIÓN PANORÁMICA SUAVE AL MOVER EL RATÓN\n    lightbox.addEventListener('mousemove', function(e) {\n      if (currentScale <= 1) return;\n\n      const rect = lightboxImg.getBoundingClientRect();\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n\n      const xPercent = (x / rect.width) * 100;\n      const yPercent = (y / rect.height) * 100;\n\n      // Permite que la imagen se mueva a los lados, arriba y abajo siguiendo tu mirada\n      lightboxImg.style.transformOrigin = `${xPercent}% ${yPercent}%`;\n    });\n\n    // 4. CERRAR EL LIGHTBOX AL HACER CLIC EN EL FONDO OSCURO\n    lightbox.addEventListener('click', (e) => {\n      // Si el usuario hace clic afuera de la imagen, o si la imagen no tiene zoom, se cierra\n      if (e.target === lightbox || currentScale === 1) {\n        lightbox.style.display = 'none';\n        lightboxImg.src = '';\n        resetZoom();\n      }\n    });\n\n    // 5. CERRAR CON LA TECLA ESCAPE\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'Escape') {\n        lightbox.style.display = 'none';\n        lightboxImg.src = '';\n        resetZoom();\n      }\n    });\n  });\n</script>\n",
        "html_before": "",
