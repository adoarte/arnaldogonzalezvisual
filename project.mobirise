              "display": "none",
              "justify-content": "center",
              "align-items": "center",
              "z-index": "9999"
            },
            "#custom-modal.active": {
              "display": "flex"
            },
            ".modal-wrapper": {
              "max-width": "95%",
              "max-height": "95%",
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center"
            },
            "#modal-img": {
              "max-width": "95vw",
              "max-height": "80vh",
              "object-fit": "contain",
              "margin-bottom": "10px"
            },
            "#modal-caption": {
              "display": "block",
              "color": "#000",
              "font-size": "medium",
              "font-family": "'Helvetica Neue', Arial, sans-serif",
              "font-weight": "400",
              "text-align": "center",
              "max-width": "90%",
              "line-height": "1.5",
