            "@media (max-width: 991px)": {
              ".lightbox-overlay img": {
                "width": "100%",
                "height": "auto",
                "max-height": "none"
              }
            },
            ".lightbox-overlay img:hover": {
              "transform": "scale(1.05)"
            }
