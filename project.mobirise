        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "center",
              "color": "#cccccc"
            }
          },
          "_name": "header2",
          "_customHTML": "<section group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n         'mbr-fullscreen': fullScreen,\n         'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full-Screen\" name=\"fullScreen\" checked>\n        <input type=\"range\" inline title=\"Oben\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Unten\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Pfeil Anzeigen\" name=\"showArrow\">\n        <input type=\"checkbox\" title=\"Titel Anzeigen\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Untertitel Anzeigen\" name=\"showSubTitle\">\n        <input type=\"checkbox\" title=\"Text Anzeigen\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons Anzeigen\" name=\"showButtons\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Hintergrundbild\" value=\"@PROJECT_PATH@/assets/images/impuls-core-12-by-arnaldo-drs-gonzlez.gif\" selected parallax>\n            <input type=\"color\" title=\"Hintergrundfarbe\" value=\"#073B4C\">\n            <input type=\"video\" title=\"Hintergrundvideo\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay-Farbe\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Transparenz\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container align-center\">\n        <div class=\"row justify-content-md-center\">\n            <div class=\"mbr-white col-md-10\">\n                <h1 class=\"mbr-section-title mbr-bold pb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\"I work with found materials and an industrial green fabric as a membrane of friction. My work maps unstable territories and fragmented experiences, revealing what is hidden, replaced, and what resists.\"</h1>\n                <h3 class=\"mbr-section-subtitle align-center mbr-light pb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showSubTitle\"><br><br><br><br><br><br><br><br>UPCOMING<div><br><br></div></h3>\n                <p class=\"mbr-text pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><br><br><br><br><br><br><br><br><br><br><br><br><br><br>:: what remains,\nand what can emerge, when the structures through which we recognize our surroundings begin to dissolve?&nbsp;::<i><b><br></b></i><br><br><br></p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                    <a class=\"btn btn-md btn-secondary\" href=\"https://mobiri.se\">MEHR INFO</a>\n                    <a class=\"btn btn-md btn-white-outline\" href=\"https://mobiri.se\">LIVE DEMO</a>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div mbr-if=\"showArrow\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n        <a href=\"#next\">\n            <i class=\"mbri-down mbr-iconfont\"></i>\n        </a>\n    </div>\n</section>",
          "_anchor": "header2-5x",
          "_isUserblock": true,
          "_sourceTheme": "mobirise4",
          "_cid": "veDdvVPuB9",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            ".carousel-container": {
              "display": "flex",
              "overflow-x": "auto",
              "gap": "30px",
              "padding": "10px",
              "background": "#fff",
              "cursor": "grab",
              "scrollbar-width": "thin",
              "scrollbar-color": "rgba(0, 0, 0, 0.25) transparent"
            },
            ".carousel-container::-webkit-scrollbar": {
              "height": "6px"
            },
            ".carousel-container::-webkit-scrollbar-track": {
              "background": "transparent"
            },
            ".carousel-container::-webkit-scrollbar-thumb": {
              "background": "rgba(0, 0, 0, 0.25)",
              "border-radius": "10px",
              "transition": "background 0.3s ease"
            },
            ".carousel-container::-webkit-scrollbar-thumb:hover": {
              "background": "rgba(0, 0, 0, 0.45)"
            },
            ".carousel-container:active": {
              "cursor": "grabbing"
            },
            ".slide": {
              "flex": "0 0 auto",
              "height": "180px"
            },
            "@media (min-width: 1024px)": {
              ".slide": {
                "height": "600px"
              }
            },
            ".slide img": {
              "display": "block",
              "height": "100%",
              "width": "auto",
              "object-fit": "contain",
              "cursor": "pointer",
              "transition": "transform 0.3s"
            },
            "@media (hover: hover) and (pointer: fine)": {
              ".slide img:hover": {
                "transform": "scale(1.05)"
              }
            },
            "#custom-modal": {
              "position": "fixed",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "background": "#fff",
              "display": "none",
              "justify-content": "center",
              "align-items": "center",
              "z-index": "9999"
            },
            "#custom-modal.active": {
              "display": "flex"
            },
            ".modal-wrapper": {
              "max-width": "95%",
              "max-height": "95%",
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center"
            },
            "#modal-img": {
              "max-width": "95vw",
              "max-height": "80vh",
              "object-fit": "contain",
              "margin-bottom": "10px"
            },
            "#modal-caption": {
              "display": "block",
              "color": "#000",
              "font-size": "medium",
              "font-family": "'Helvetica Neue', Arial, sans-serif",
              "font-weight": "400",
              "text-align": "center",
              "max-width": "90%",
              "line-height": "1.5",
              "margin-top": "10px",
              "text-shadow": "1px 1px 2px rgba(0, 0, 0, 0.2)"
            },
            ".modal-close": {
              "position": "absolute",
              "top": "10px",
              "right": "10px",
              "font-size": "32px",
              "background": "none",
              "border": "none",
              "cursor": "pointer"
            },
            ".modal-arrow": {
              "position": "absolute",
              "top": "50%",
              "transform": "translateY(-50%)",
              "font-size": "40px",
              "background": "none",
              "border": "none",
              "cursor": "pointer"
            },
            ".modal-arrow.left": {
              "left": "10px"
            },
            ".modal-arrow.right": {
              "right": "10px"
            },
            "@media (max-width: 1023px)": {
              ".modal-arrow": {
                "display": "none"
              }
            }
          },
          "_name": "image2",
          "_customHTML": "<section group=\"Images & Videos\">\n\n  <div class=\"carousel-wrapper\">\n  <figure class=\"mbr-figure\">\n    <div class=\"carousel-container\">\n    \n                 <div class=\"slide\">\n        <img src=\"@PROJECT_PATH@/assets/images/screening-view-t.i.v.a.-tirana-international-video-art-festival-albania-2025-2100x1200.jpg\" alt=\"Imagen 1\" data-caption=\"Screening view, T.I.V.A. Tirana International Video Art Festival, kinemanë DRITA, Arkivi Qendror Shtetëror i Filmit (Central State Film Archive), Tirana, Albania, 2026\" title>\n      </div>\n      \n                  <div class=\"slide\">\n        <img src=\"@PROJECT_PATH@/assets/images/topographies-of-tents-terracotta-and-time-2025-exhibition-view-srishti-art-gallery-hyderabad-8-2100x1400.jpg\" alt=\"Imagen 2\" data-caption=\"Exhibition view, Topographies of Tents, Terracotta and Time, with Sudakar Chippa, Srishti Art Gallery, India, 2025. Curated by Mathew Partridge\" title>\n      </div>\n\n                <div class=\"slide\">\n        <img src=\"@PROJECT_PATH@/assets/images/w-arnaldo-drs-gonzlez-resguardo-y-presencia-vorwerk-stift-hamburg-2022-32-1804x1199.jpg\" alt=\"Imagen 3\" data-caption=\"Exhibition view, Resguardo y Presencia, Künstlerhaus Vorwerk-Stift Hamburg, 2022\" title>\n      </div>\n      \n                <div class=\"slide\">\n        <img src=\"@PROJECT_PATH@/assets/images/rw-installation-stadhagen-2022-1804x1199.jpg\" alt data-caption=\"Installation view, Transformationen, duo with Swen Kählert, Historische Zehntscheune Stadthagen, Germany, 2022\" title>\n         </div>\n         \n                <div class=\"slide\">\n        <img src=\"@PROJECT_PATH@/assets/images/10-2-2220x1476.jpg\" alt data-caption=\"Performance and installation view, Resguardo y Presencia - AKTION #239, 2025 Kunst und Kultur, Hamburg, Germany, 2018\" title>\n         </div>         \n         \n  </div>   \n  </figure>\n\n<!-- MODAL PERSONALIZADO -->\n<div id=\"custom-modal\">\n  <button class=\"modal-close\">×</button>\n  <button class=\"modal-arrow left\">❮</button>\n  <button class=\"modal-arrow right\">❯</button>\n\n  <div class=\"modal-wrapper\">\n    <div class=\"modal-slide\">\n      <img id=\"modal-img\" src alt>\n      <div id=\"modal-caption\" style=\"display:block;\"></div>\n    </div>\n  </div>\n</div>\n\n\n</div></section>",
