            },
            "#custom-modal.active": {
              "display": "flex"
            },
            ".modal-wrapper": {
              "max-width": "95%",
              "max-height": "95%",
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center"
            },
            "#modal-img": {
              "max-width": "95vw",
