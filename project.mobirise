              "background-color": "#ffffff",
              "justify-content": "center",
              "align-items": "center",
              "z-index": "9999",
              "cursor": "pointer"
            },
            ".lightbox-overlay img": {
              "max-width": "90%",
              "max-height": "90%",
              "object-fit": "contain",
              "transition": "transform 0.3s ease"
            },
            "@media (min-width: 992px)": {
