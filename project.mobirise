    "movingimage.html": {
      "settings": {
        "title": "Video works | Arnaldo Drés González",
        "meta_descr": "Arnaldo Drés González is a Venezuelan visual artist based in Hamburg exploring the instability of perception, bodily memory, displacement, and the transformation of moving image into spatial and material form.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": 2,
        "meta_image": "@PROJECT_PATH@/assets/images/arnaldo-gonzlez-mente-en-blanco-de-la-serie-impuls-video-proyeccin-galera-level-one-hamburgo-alemania-2015-1466x975.jpg"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
