  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Home | Arnaldo Drés González",
        "meta_descr": "Venezuelan visual artist based in Hamburg, Germany, whose practice explores the relationship between human introspection and visual poetic experiences through drawings, pictorial interventions, video and photography. His work recreates the ambiguity of human connections, social values, tensions and conflicts of everyday life, inspired by the metaphors of existence, fear, refuge, identity, transit and territory. His ongoing research focuses on turning functional and aesthetic appearances of found materials into symbolic narratives and using the body itself, to transform it into new materialities through digital practices.",
        "header_custom": "<style>\n  /* Creamos la animación de desvanecimiento */\n  @keyframes entradaPoetica {\n    from { opacity: 0; }\n    to { opacity: 1; }\n  }\n\n  /* Buscamos el bloque exacto del texto por su estilo de Mobirise template */\n  .carousel-wrapper + ::-webkit-scrollbar, \n  amp-carousel + p, \n  .carousel-wrapper ~ p,\n  section p {\n    /* Si el elemento contiene tu cita, se activará este efecto */\n  }\n\n  /* Para asegurarnos al 100%, creamos una clase manual */\n  .mi-texto-fade {\n    animation: entradaPoetica 3.5s ease-in-out forwards !important;\n  }\n</style>\n\n",
        "footer_custom": "<script>\ndocument.addEventListener(\"DOMContentLoaded\", function(){\n  // 1. INYECTAR CLASE AL TEXTO DEL FADE\n  const todosLosParrafos = document.querySelectorAll(\"p, div, span, h3\");\n  todosLosParrafos.forEach(el => {\n    if (el.textContent.includes(\"recognize our surroundings\") || el.textContent.includes(\"begin to dissolve\")) {\n      el.classList.add(\"mi-texto-fade\");\n    }\n  });\n\n  // 2. LOGICA DEL CARRUSEL Y MODAL CON ZOOM DIRIGIDO AL PUNTERO\n  const track = document.querySelector(\".carousel-container\");\n  const slides = document.querySelectorAll(\".slide img\");\n  const modal = document.getElementById(\"custom-modal\");\n  const modalImg = document.getElementById(\"modal-img\");\n  const modalCaption = document.getElementById(\"modal-caption\");\n  const modalClose = modal ? modal.querySelector(\".modal-close\") : null;\n  const prevBtn = modal ? modal.querySelector(\".modal-arrow.left\") : null;\n  const nextBtn = modal ? modal.querySelector(\".modal-arrow.right\") : null;\n\n  let currentIndex = 0;\n  let isDragging = false;\n  let startX = 0;\n  let scrollLeft = 0;\n  let dragMoved = false;\n\n  // Variables para el control del zoom con la rueda del ratón\n  let currentScale = 1;\n  const minScale = 1;\n  const maxScale = 5; // Límite máximo de zoom (5x)\n  const zoomSpeed = 0.2; // Sensibilidad calibrada para el zoom\n\n  // Forzar estilos iniciales en la imagen del modal para transiciones limpias\n  if (modalImg) {\n    modalImg.style.transition = 'transform 0.1s ease-out';\n    modalImg.style.transformOrigin = 'center center';\n  }\n\n  // Evitar arrastre nativo de archivos de imagen\n  slides.forEach((img) => {\n    img.addEventListener('dragstart', (e) => e.preventDefault());\n  });\n\n  // Controlar la apertura del Modal\n  slides.forEach((img, index) => {\n    img.addEventListener(\"click\", (e) => {\n      if (dragMoved) {\n        e.preventDefault();\n        e.stopPropagation();\n        return; \n      }\n      if (modal && modalImg) {\n        resetZoom(); // Resetear zoom al abrir una nueva imagen\n        modal.classList.add(\"active\");\n        modalImg.src = img.src;\n        if (modalCaption) modalCaption.textContent = img.dataset.caption || \"\";\n        currentIndex = index;\n      }\n    });\n  });\n\n  // Arrastre por ratón en el carrusel de la Home\n  if (track) {\n    track.addEventListener('mousedown', (e) => {\n      isDragging = true;\n      dragMoved = false;\n      startX = e.pageX - track.offsetLeft;\n      scrollLeft = track.scrollLeft;\n    });\n\n    track.addEventListener('mouseleave', () => { isDragging = false; });\n    \n    window.addEventListener('mouseup', () => {\n      if (isDragging) {\n        isDragging = false;\n        setTimeout(() => { dragMoved = false; }, 60);\n      }\n    });\n\n    track.addEventListener('mousemove', (e) => {\n      if (!isDragging) return;\n      e.preventDefault(); \n      const x = e.pageX - track.offsetLeft;\n      const walk = (x - startX) * 1.5; \n      if (Math.abs(walk) > 5) {\n        dragMoved = true;\n      }\n      track.scrollLeft = scrollLeft - walk;\n    });\n  }\n\n  // ==========================================\n  // FUNCIONALIDAD DE ZOOM SEGUIDOR CON RUEDA (HOME)\n  // ==========================================\n  if (modal && modalImg) {\n    modal.addEventListener('wheel', function(e) {\n      e.preventDefault(); // Evita el scroll de fondo\n\n      // Calcular la posición del mouse relativa a las dimensiones de la imagen\n      const rect = modalImg.getBoundingClientRect();\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n\n      // Obtener porcentajes exactos de ubicación del puntero del ratón\n      const xPercent = (x / rect.width) * 100;\n      const yPercent = (y / rect.height) * 100;\n\n      // Cambiar nivel del zoom según dirección del scroll\n      if (e.deltaY < 0) {\n        currentScale = Math.min(maxScale, currentScale + zoomSpeed);\n      } else {\n        currentScale = Math.max(minScale, currentScale - zoomSpeed);\n      }\n\n      if (currentScale <= 1) {\n        resetZoom();\n      } else {\n        // Fijamos el centro de ampliación exactamente bajo el puntero actual\n        modalImg.style.transformOrigin = `${xPercent}% ${yPercent}%`;\n        modalImg.style.transform = `scale(${currentScale})`;\n        modalImg.style.cursor = 'zoom-out';\n      }\n    }, { passive: false });\n\n    // EXPLORACIÓN PANORÁMICA SUAVE AL MOVER EL RATÓN\n    modal.addEventListener('mousemove', function(e) {\n      if (currentScale <= 1) return;\n\n      const rect = modalImg.getBoundingClientRect();\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n\n      const xPercent = (x / rect.width) * 100;\n      const yPercent = (y / rect.height) * 100;\n\n      // Desplaza la imagen dinámicamente según la mirada del usuario\n      modalImg.style.transformOrigin = `${xPercent}% ${yPercent}%`;\n    });\n  }\n\n  // Función para restaurar la imagen a su tamaño original\n  function resetZoom() {\n    currentScale = 1;\n    if (modalImg) {\n      modalImg.style.transform = 'scale(1)';\n      modalImg.style.transformOrigin = 'center center';\n      modalImg.style.cursor = 'zoom-in';\n    }\n  }\n\n  // Controles de navegación y cierre del modal\n  if (modalClose) {\n    modalClose.addEventListener(\"click\", () => {\n      modal.classList.remove(\"active\");\n      resetZoom();\n    });\n  }\n  \n  if (modal) {\n    modal.addEventListener(\"click\", e => { \n      if (e.target === modal || (currentScale === 1 && e.target === modalImg)) {\n        modal.classList.remove(\"active\");\n        resetZoom();\n      }\n    }); \n  }\n\n  if (prevBtn) {\n    prevBtn.addEventListener(\"click\", (e) => {\n      e.stopPropagation();\n      resetZoom();\n      currentIndex = (currentIndex - 1 + slides.length) % slides.length;\n      if (modalImg) modalImg.src = slides[currentIndex].src;\n      if (modalCaption) modalCaption.textContent = slides[currentIndex].dataset.caption || \"\";\n    });\n  }\n\n  if (nextBtn) {\n    nextBtn.addEventListener(\"click\", (e) => {\n      e.stopPropagation();\n      resetZoom();\n      currentIndex = (currentIndex + 1) % slides.length;\n      if (modalImg) modalImg.src = slides[currentIndex].src;\n      if (modalCaption) modalCaption.textContent = slides[currentIndex].dataset.caption || \"\";\n    });\n  }\n\n  document.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape' && modal) {\n      modal.classList.remove(\"active\");\n      resetZoom();\n    }\n  });\n});\n</script>\n\n",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/arnaldo-gonzlez-mente-en-blanco-de-la-serie-impuls-video-proyeccin-galera-level-one-hamburgo-alemania-2015-1466x975.jpg"
      },
      "components": [
